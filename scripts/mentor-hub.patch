+import React,{useEffect,useState,useSyncExternalStore} from 'react';
+import {Bookmark,MessageCircleMore} from 'lucide-react';
+import {Button} from './MentorUI';
+import {Dialog,DialogContent,DialogDescription,DialogTitle} from '@/components/ui/dialog';
+import type {Role} from './identity';
+
+const entry=new URLSearchParams(location.search);
+export const initialPerson=entry.get('person');
+export const resumedPlan=entry.get('resumePlan');
+export function signInToBook(person:string,plan:{id:string;price:number}){
+  window.dispatchEvent(new CustomEvent('hub-booking-signin',{detail:{person,plan:plan.id,scenario:plan.price?'booking-paid':'booking-free'}}));
+}
+const screen=entry.get('screen');
+export const favoritesEntry=screen==='favorites';
+export const searchVariant=screen==='mentor-search'?entry.get('scenario'):null;
+const profileVariant=screen==='public-profile'?entry.get('scenario'):null;
+let guest=['guest','login','favorite-login'].includes(entry.get('scenario')||'');
+export const guestEntry=()=>guest;
+export const initialAccountMenu=()=>entry.get('menuOpen')==='1'||searchVariant==='menu';
+
+export function sharedEntryRole(scene:string):Role|undefined{
+  const role=entry.get('memberRole');
+  if(role!=='mentor'&&role!=='mentee')return;
+  if(!guest && (screen==='mentor-search' || favoritesEntry || (screen==='team-support' && scene!=='support-guest')))return role;
+}
+export function navigateHub(screen:string){
+  window.dispatchEvent(new CustomEvent('hub-navigate',{detail:{screen}}));
+}
+export function flowAttributes(id?:string){
+  const entry=id&&(window as any).MENTOR_SCREENS[id];
+  return entry?{'data-hub-screen':id,'data-role':entry.role,'data-ticket':entry.ticket}:{};
+}
+
+const favorites=(window as any).hubFavorites;
+let saved:string[]=favorites.read(guest?'guest':favoritesEntry?entry.get('scenario'):profileVariant||'default');
+export function useSavedPeople(){
+  const ids=useSyncExternalStore(subscribe,()=>saved);
+  return (person:string)=>ids.includes(favorites.ids[person]??person);
+}
+function subscribe(change:()=>void){
+  window.addEventListener('hub-favorites-change',change);
+  return ()=>window.removeEventListener('hub-favorites-change',change);
+}
+function saveIds(ids:string[]){
+  saved=favorites.save(ids);
+  window.dispatchEvent(new Event('hub-favorites-change'));
+}
+export function useFavoriteCount(){
+  return useSyncExternalStore(subscribe,()=>saved.length);
+}
+
+export function HubBookmark({person,name,card=false,onSignedIn}:{person:string;name:string;card?:boolean;onSignedIn?:()=>void}){
+  const id=favorites.ids[person]??person;
+  const selected=useSyncExternalStore(subscribe,()=>saved.includes(id));
+  const [login,setLogin]=useState(guest&&(card?searchVariant==='favorite-login'&&person==='zahra':profileVariant==='login'));
+  const [notice,setNotice]=useState(!card&&profileVariant==='failure'?'收藏失敗，請再試一次':!card&&profileVariant==='saved'?'已收藏導師':'');
+  useEffect(()=>{
+    if(!notice||notice.startsWith('收藏失敗'))return;
+    const timer=window.setTimeout(()=>setNotice(''),4500);
+    return ()=>window.clearTimeout(timer);
+  },[notice]);
+  function showNotice(title:string){
+    if(card)window.dispatchEvent(new CustomEvent('hub-favorite-notice',{detail:title}));
+    else setNotice(title);
+  }
+  function toggle(){
+    if(guest){setLogin(true);return}
+    saveIds(selected?saved.filter(value=>value!==id):[...saved,id]);
+    showNotice(selected?'已取消收藏':'已收藏導師');
+  }
+  function signIn(){
+    guest=false;
+    setLogin(false);
+    saveIds([...new Set<string>([...favorites.read('default'),id])]);
+    window.dispatchEvent(new Event('hub-sign-in'));
+    showNotice('已收藏導師');
+    onSignedIn?.();
+  }
+  const label=selected?'取消收藏':'收藏';
+  return <>
+    <button type="button" data-hub-component="favorite-toggle" className={card?'p2-card-save':'mp-action'} onClick={toggle}
+      aria-label={card?label+' '+name:label+'導師'} title={label} aria-pressed={selected}>
+      <Bookmark size={20} fill={selected?'currentColor':'none'}/>
+    </button>
+    {notice&&<div className="xt-toast" data-hub-component="toast" role={notice.startsWith('收藏失敗')?'alert':'status'}>
+      {notice}<button aria-label="關閉提示" onClick={()=>setNotice('')}>×</button>
