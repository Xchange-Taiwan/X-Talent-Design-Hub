+import React,{useState} from 'react';
+import {Bookmark,MessageCircleMore} from 'lucide-react';
+import {Button} from './MentorUI';
+import {Dialog,DialogContent,DialogDescription,DialogTitle} from '@/components/ui/dialog';
+
+const query=new URLSearchParams(location.search);
+export const initialPerson=query.get('person');
+export function flowAttributes(id?:string){
+ const entry=id&&(window as any).MENTOR_SCREENS[id];
+ return entry?{'data-hub-screen':id,'data-role':entry.role,'data-ticket':entry.ticket}:{};
+}
+export const guestEntry=()=>['guest','login'].includes(query.get('scenario')||'');
+const entry=query.get('screen')==='public-profile'?query.get('scenario'):'default';
+export function HubPublicActions({person,name}:{person:string;name:string}){
+ const store=(window as any).hubFavorites;
+ const id=store.ids[person]??person;
+ const [saved,setSaved]=useState<string[]>(()=>store.read(entry));
+ const [guest,setGuest]=useState(guestEntry);
+ const [login,setLogin]=useState(entry==='login');
+ const [notice,setNotice]=useState(entry==='failure'?'收藏失敗，請再試一次':entry==='saved'?'已收藏導師':'');
+ function toggle(){
+   if(guest){setLogin(true);return;}
+   const on=saved.includes(id);
+   setSaved(store.save(on?saved.filter(value=>value!==id):[...saved,id]));
+   setNotice(on?'已取消收藏':'已收藏導師');
+ }
